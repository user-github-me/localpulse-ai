{
  "name": "localpulse-ai",
  "description": "Privacy-first, open-source browser copilot with on-device AI, local study tools, follow-ups and optional encrypted email read activity.",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "node scripts/fetch-webllm-libs.mjs && wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:e2e": "wxt build --mode e2e",
    "zip": "node scripts/fetch-webllm-libs.mjs && wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "crx": "node scripts/pack-crx.mjs",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test tools/email-tracker/server.test.mjs",
    "test:tracker": "node --test tools/email-tracker/server.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "wxt build && wxt build --mode e2e && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "check": "tsc --noEmit && eslint . && vitest run && node --test tools/email-tracker/server.test.mjs && wxt build && wxt build --mode e2e && playwright test",
    "postinstall": "wxt prepare",
    "webllm-libs": "node scripts/fetch-webllm-libs.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@mozilla/readability": "^0.6.0",
    "@wxt-dev/i18n": "^0.2.7",
    "dexie": "^4.4.6",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
